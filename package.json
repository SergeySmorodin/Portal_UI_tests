{
  "name": "portal_ui_tests",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "test": "playwright test",
    "test:headed": "playwright test --headed",
    "test:debug": "playwright test --debug",
    "test:ui": "playwright test --ui",
    "test:report": "playwright show-report",
    "test:chromium": "playwright test --project=chromium",
    "test:login": "playwright test src/tests/login_page",
    "test:main": "playwright test src/tests/main_page",
    "test:lk": "playwright test src/tests/profile_page",
    "test:tdo": "playwright test src/tests/tdo_page",
    "test:counterparties": "playwright test src/tests/counterparties_page",
    "test:certification": "playwright test src/tests/certification_page",
    "test:workflows": "playwright test src/tests/workflows",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "check": "npm run lint && npm run format:check && npm run typecheck",
    "report:save": "node scripts/save-report.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SergeySmorodin/Portal_UI_tests.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "bugs": {
    "url": "https://github.com/SergeySmorodin/Portal_UI_tests/issues"
  },
  "homepage": "https://github.com/SergeySmorodin/Portal_UI_tests#readme",
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.62.1",
    "@types/node": "^26.2.0",
    "dotenv": "^17.4.2",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.6",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.68.0"
  }
}
